# Server
PORT=3001

# Gemma 4 opponent moves (Learn / Play vs Computer) — get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMMA_MODEL=gemma-4-26b-a4b-it
# GEMMA_TIMEOUT_MS=25000

# Optional: persist finished multiplayer games to MongoDB Atlas
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
# MONGODB_DB=jade_court

# Web production overrides (leave unset in local dev — Vite proxy handles /api and /ws)
# VITE_API_URL=https://api.example.com
# VITE_WS_URL=wss://api.example.com/ws
