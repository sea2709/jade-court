# Jade Court — copy to `.env` at repo root (gitignored)
#
# Web (Vite): only `VITE_*` are exposed in the browser bundle.
# Server (Hono): use names without the `VITE_` prefix for secrets.

# --- Server (Hono) ---

PORT=3001

# LLM — opponent moves + Master Lin coach (Learn)
# LLM_PROVIDER=gemini          # gemini | openai | anthropic
# LLM_MODEL=gemma-4-26b-a4b-it # provider-specific model id
# LLM_TIMEOUT_MS=25000
# LLM_HISTORY_LIMIT=150
# LLM_LOG_TOKENS=1             # dev token logging (fallback: GEMMA_LOG_TOKENS)

# Provider API keys (only the active LLM_PROVIDER key is required)
# GEMINI_API_KEY=              # https://aistudio.google.com/apikey
# OPENAI_API_KEY=              # https://platform.openai.com/api-keys
# ANTHROPIC_API_KEY=           # https://console.anthropic.com/

# Legacy fallbacks (still read when LLM_* unset)
# GEMINI_MODEL=gemma-4-26b-a4b-it
# GEMINI_TIMEOUT_MS=25000
# GEMINI_HISTORY_LIMIT=150
# GEMMA_LOG_TOKENS=1

# Play vs Computer — Pikafish UCI (https://github.com/official-pikafish/Pikafish/releases)
# PLAY_OPPONENT_PROVIDER=engine   # engine | llm | local
# PIKAFISH_PATH=/usr/local/bin/pikafish
# ENGINE_MOVE_TIMEOUT_MS=30000

# Optional: persist finished multiplayer games to MongoDB Atlas
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
# MONGODB_DB=jade_court

# --- Web (Vite) — production overrides; leave unset in local dev (Vite proxy handles /api and /ws) ---

# VITE_API_URL=https://api.example.com
# VITE_WS_URL=wss://api.example.com/ws
