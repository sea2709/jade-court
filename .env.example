# Jade Court — copy to `.env` at repo root (gitignored)
#
# Web (Vite): only `VITE_*` are exposed in the browser bundle.
# Server (Hono): use names without the `VITE_` prefix for secrets.

# --- Server (Hono) ---

PORT=3001

# LLM — opponent moves + Master Lin coach (Learn)
# LLM_PROVIDER=gemini          # gemini | openai | anthropic
# LLM_MODEL=gemma-4-26b-a4b-it # provider-specific model id
# LLM_TIMEOUT_MS=25000
# LLM_HISTORY_LIMIT=150
# LLM_LOG_TOKENS=1             # dev token logging

# Provider API keys (only the active LLM_PROVIDER key is required)
# GEMINI_API_KEY=              # https://aistudio.google.com/apikey
# OPENAI_API_KEY=              # https://platform.openai.com/api-keys
# ANTHROPIC_API_KEY=           # https://console.anthropic.com/

# Play vs Computer — Pikafish UCI (https://github.com/official-pikafish/Pikafish/releases)
# PLAY_OPPONENT_PROVIDER=engine   # engine | llm | local
# PIKAFISH_PATH=/usr/local/bin/pikafish
# ENGINE_MOVE_TIMEOUT_MS=30000

# Optional: persist finished multiplayer games to MongoDB Atlas
# (`pnpm dev:docker` ignores this and uses its own `mongo` container)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
# MONGODB_DB=jade_court

# --- Docker dev stack (`pnpm dev:docker`, docker-compose.dev.yml) ---

# Host folder with the Pikafish binary + pikafish.nnue, mounted read-only into the server
# container (PIKAFISH_PATH above is a host path and is overridden there). Use an absolute path.
# PIKAFISH_DIR=/home/you/.local/share/pikafish/Pikafish-2026-01-02
# PIKAFISH_BIN=pikafish              # binary file name inside PIKAFISH_DIR
# JADE_DEV_MONGO_PORT=27018          # host port for the dev MongoDB container

# Player accounts (server only — never expose as VITE_*)
# SESSION_SECRET=                 # 32+ random chars, e.g. openssl rand -hex 32
# SESSION_TTL_HOURS=720           # default 30 days
# PLAY_AI_ACCESS_HOURS=24         # day-pass default; clamped to 8760h max (1 year)

# Stripe day-pass Checkout (server only)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen` or Dashboard webhook endpoint
# STRIPE_E2E_FAKE=1                 # optional: fake Stripe (no API) when not NODE_ENV=test
# E2E_TEST_SECRET=                  # Playwright + test-only routes (x-e2e-test-secret); never on staging/prod
# BILLING_REQUIRE_VERIFIED_EMAIL=true   # set false in dev to checkout without verifying email

# Transactional email (verification + password reset)
# EMAIL_PROVIDER=console          # console | resend | smtp (default console)
# PUBLIC_APP_URL=http://localhost:5173   # link base for verify/reset emails and OAuth redirects
# APP_BASE_URL=http://localhost:5173     # optional alias for OAuth (falls back to PUBLIC_APP_URL)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# OAUTH_FAKE_ENABLED=0                   # dev only: enable fake OAuth with NODE_ENV=development (never production)
# EMAIL_FROM=noreply@example.com
# EMAIL_VERIFY_TTL_HOURS=48
# EMAIL_RESET_TTL_HOURS=1
# RESEND_API_KEY=                 # when EMAIL_PROVIDER=resend
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false               # true for port 465

# Admin panel (server only — never expose as VITE_*)
# ADMIN_USERS=alice:change-me     # admin sessions are signed with a per-process key; restart logs admins out
# ADMIN_SESSION_TTL_HOURS=8

# Curator-uploaded news thumbnails (server only; default `<repo>/data/news-images`)
# NEWS_IMAGE_DIR=

# --- Web (Vite) — production overrides; leave unset in local dev (Vite proxy handles /api and /ws) ---

# VITE_API_URL=https://api.example.com
# VITE_WS_URL=wss://api.example.com/ws
