{
  "name": "@jade-court/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "dev:debug": "NODE_ENV=development node --import tsx --inspect=9229 src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.101.0",
    "@google/genai": "^2.7.0",
    "@hono/node-server": "^1.13.7",
    "@jade-court/xiangqi-engine": "workspace:*",
    "dotenv": "^17.4.2",
    "hono": "^4.6.16",
    "jose": "^6.2.13",
    "mongodb": "^6.12.0",
    "node-html-parser": "^9.0.4",
    "nodemailer": "^10.2.0",
    "openai": "^6.42.0",
    "stripe": "^23.0.1",
    "undici": "^7.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
